# Generated by armtune - optimal llama.cpp serving image for this Arm64 host
FROM --platform=linux/arm64 ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp /src
# -mcpu=native picks up NEON/dotprod/i8mm/SVE on the build host
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=ON \
    && cmake --build /build --target llama-server -j

FROM --platform=linux/arm64 ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/bin/llama-server /usr/local/bin/llama-server
# Mount your Q4_0 model at /models/model.gguf
EXPOSE 8080
HEALTHCHECK CMD curl -f http://localhost:8080/health || exit 1
ENTRYPOINT ["llama-server", "-m", "/models/model.gguf", \
  "-t", "4", "-b", "512", "--host", "0.0.0.0", "--port", "8080", "-fa", "1"]
